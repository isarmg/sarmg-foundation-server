{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isarmg.org/schemas/release-v1.json",
  "title": "iSarmg Release Binding",
  "type": "object",
  "additionalProperties": false,
  "required": ["product", "version", "source_revision", "target", "state_contract_sha256", "upgrade_tool"],
  "properties": {
    "product": { "$ref": "state-contract.schema.json#/$defs/identifier" },
    "version": { "$ref": "state-contract.schema.json#/$defs/identifier" },
    "source_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "target": { "$ref": "state-contract.schema.json#/$defs/identifier" },
    "state_contract_sha256": { "$ref": "state-contract.schema.json#/$defs/sha256" },
    "upgrade_tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_version", "artifact", "sha256", "required_capabilities"],
      "properties": {
        "minimum_version": { "$ref": "state-contract.schema.json#/$defs/identifier" },
        "artifact": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,255}$" },
        "sha256": { "$ref": "state-contract.schema.json#/$defs/sha256" },
        "required_capabilities": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "state-contract.schema.json#/$defs/identifier" }
        }
      }
    }
  }
}
