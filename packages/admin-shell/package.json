{
  "name": "@sarmg/admin-shell",
  "version": "0.7.1",
  "description": "Administrator login, recovery, navigation, theme and error shell",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./native": {
      "types": "./dist/native-workspace.d.ts",
      "import": "./dist/native-workspace.js"
    },
    "./workspace-config": {
      "types": "./dist/workspace-config.d.ts",
      "import": "./dist/workspace-config.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && pnpm run test:types && node --test test/*.test.mjs",
    "test:types": "tsc --noEmit --strict --target ES2022 --module ESNext --moduleResolution bundler --skipLibCheck test/workspace-types.ts"
  },
  "peerDependencies": {
    "@sarmg/admin-ui": "0.7.1",
    "@sarmg/admin-web": "0.7.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@sarmg/admin-ui": "workspace:0.7.1",
    "@sarmg/admin-web": "workspace:0.7.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=26.7.0 <27"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
