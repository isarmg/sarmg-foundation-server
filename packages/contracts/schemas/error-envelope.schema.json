{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sarmg.org/schemas/error-envelope-v1.json",
  "title": "Sarmg Error Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "message", "retryable"],
  "properties": {
    "code": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$" },
    "message": { "type": "string" },
    "request_id": { "$ref": "state-contract.schema.json#/$defs/identifier" },
    "retryable": { "type": "boolean" },
    "details": { "type": "object" }
  }
}
