{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sarmg.org/schemas/release-v1.json",
  "title": "Sarmg Release Identity",
  "type": "object",
  "additionalProperties": false,
  "required": ["product", "version", "source_revision", "target", "state_contract_sha256"],
  "properties": {
    "product": { "$ref": "state-contract.schema.json#/$defs/identifier" },
    "version": { "$ref": "state-contract.schema.json#/$defs/identifier" },
    "source_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "target": { "$ref": "state-contract.schema.json#/$defs/identifier" },
    "state_contract_sha256": { "$ref": "state-contract.schema.json#/$defs/sha256" }
  }
}
