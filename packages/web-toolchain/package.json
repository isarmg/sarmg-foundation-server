{
  "name": "@xcss/web-toolchain",
  "version": "1.0.0",
  "description": "Exact Node, TypeScript, React and Vite build baseline",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./tsconfig.json": "./dist/tsconfig.json",
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "pnpm run clean && tsc -p tsconfig.build.json && node scripts/copy-config.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "pnpm run build && pnpm run test:built",
    "test:built": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.3"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@vitejs/plugin-react": "6.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  },
  "engines": {
    "node": ">=26.7.0 <27"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@vitejs/plugin-react": {
      "optional": true
    }
  },
  "bin": {
    "xcss-build-server": "./dist/server-cli.js"
  }
}
