{
  "name": "@xcss/http-client",
  "version": "1.0.0",
  "description": "带有 same-origin、响应大小和取消边界的 Xcss JSON HTTP 客户端",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isarmg/xcss.git",
    "directory": "packages/http-client"
  },
  "engines": {
    "node": ">=26.7.0 <27"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @xcss/contracts build && pnpm run build && pnpm run test:built",
    "test:built": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@xcss/contracts": "1.0.0"
  },
  "devDependencies": {
    "@xcss/contracts": "workspace:1.0.0",
    "typescript": "7.0.2"
  }
}
