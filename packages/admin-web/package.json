{
  "name": "@sarmg/admin-web",
  "version": "0.3.1",
  "description": "Sarmg 管理员专用 React/Vite Web 的认证、请求与构建基线",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isarmg/sarmg-foundation.git",
    "directory": "packages/admin-web"
  },
  "engines": {
    "node": ">=26.7.0 <27"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./tsconfig.json": "./dist/tsconfig.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "pnpm run clean && tsc -p tsconfig.build.json && node scripts/copy-config.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "pnpm --filter @sarmg/contracts build && pnpm --filter @sarmg/http-client build && pnpm run build && node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@sarmg/contracts": "0.3.1",
    "@sarmg/http-client": "0.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "7.3.6"
  },
  "peerDependenciesMeta": {
    "@vitejs/plugin-react": { "optional": true },
    "react": { "optional": true },
    "react-dom": { "optional": true },
    "vite": { "optional": true }
  },
  "devDependencies": {
    "@sarmg/contracts": "workspace:0.3.1",
    "@sarmg/http-client": "workspace:0.3.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "4.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.8.3",
    "vite": "7.3.6"
  }
}
