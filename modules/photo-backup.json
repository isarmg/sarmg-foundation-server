{
  "manifest_version": 1,
  "id": "photo-backup",
  "display_name": "Photo Backup",
  "description": "HTTPS 照片分片上传、服务端明文资源库和移动端同步",
  "version": "0.1.0",
  "version_metadata": { "channel": "development", "distribution": "bundled", "license": "Apache-2.0" },
  "compatibility": {
    "core": ">=0.5.0, <0.6.0",
    "platform_api": "^1.0.0",
    "plugin_api": "^1.0.0"
  },
  "dependencies": [],
  "execution": {
    "mode": "process",
    "executable": "backend/photo-backup",
    "args": [],
    "environment": [
      { "name": "DATABASE_URL", "config_pointer": "/database_url" },
      { "name": "DATA_DIR", "config_pointer": "/data_dir" },
      { "name": "ADMIN_USERNAME", "config_pointer": "/admin/username" },
      { "name": "ADMIN_PASSWORD", "config_pointer": "/admin/password" },
      { "name": "MAX_PART_BYTES", "config_pointer": "/max_part_bytes" },
      { "name": "METRICS_TOKEN", "config_pointer": "/metrics_token" },
      { "name": "REQUIRE_HTTPS", "config_pointer": "/require_https" }
    ],
    "bind": { "host": "127.0.0.1", "port": 0, "environment": "BIND" }
  },
  "backend": {
    "api_version": "v1",
    "base_path": "/api/modules/photo-backup",
    "service": "photo-backup.api",
    "routes": [
      { "id": "mobile-api", "path": "/v1/{*path}", "upstream_path": "/v1/{*path}", "methods": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE"], "auth": "module", "permission": null },
      { "id": "admin-root", "path": "/admin", "upstream_path": "/admin", "methods": ["GET"], "auth": "platform", "permission": "photo-backup.accounts.admin" },
      { "id": "admin", "path": "/admin/{*path}", "upstream_path": "/admin/{*path}", "methods": ["GET", "POST", "PUT", "DELETE"], "auth": "platform", "permission": "photo-backup.accounts.admin" }
    ]
  },
  "frontend": {
    "entry": "frontend/entry.js",
    "styles": ["frontend/styles.css"],
    "components": ["PhotoBackupView"],
    "api_base": "/api/modules/photo-backup",
    "routes": [
      { "path": "/modules/photo-backup", "component": "PhotoBackupView", "permission": "photo-backup.assets.read" }
    ],
    "menu": [
      { "id": "library", "label": "照片", "route": "/modules/photo-backup", "permission": "photo-backup.assets.read", "order": 20 }
    ]
  },
  "permissions": [
    { "id": "photo-backup.assets.read", "description": "查看照片资源库", "default_roles": ["admin"] },
    { "id": "photo-backup.assets.write", "description": "上传照片和更新元数据", "default_roles": ["admin"] },
    { "id": "photo-backup.accounts.admin", "description": "管理照片备份账户", "default_roles": ["admin"] }
  ],
  "migrations": [
    { "id": "schema-v1", "engine": "postgresql", "directory": "migrations", "schema": "public" }
  ],
  "configuration": {
    "schema": "config/schema.json",
    "version": 1,
    "secret_fields": ["/database_url", "/admin/password", "/metrics_token"]
  },
  "health": {
    "kind": "http",
    "service": "photo-backup.api",
    "liveness_path": "/health/live",
    "readiness_path": "/health/ready",
    "interval_seconds": 10,
    "timeout_seconds": 2
  },
  "lifecycle": {
    "startup_timeout_seconds": 60,
    "shutdown_timeout_seconds": 60,
    "restart_policy": "on_failure",
    "max_restarts": 5
  },
  "services": [
    { "name": "photo-backup.api", "protocol": "http", "visibility": "platform" }
  ],
  "events": {
    "publishes": [
      { "topic": "photo-backup.asset.created", "version": 1 },
      { "topic": "photo-backup.upload.completed", "version": 1 }
    ],
    "subscribes": []
  }
}
