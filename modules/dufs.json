{
  "manifest_version": 1,
  "id": "dufs",
  "display_name": "Dufs",
  "description": "共享根文件浏览、上传、下载和持久删除",
  "version": "0.49.7",
  "version_metadata": { "channel": "development", "distribution": "bundled", "license": "Apache-2.0" },
  "compatibility": {
    "core": ">=0.5.0, <0.6.0",
    "platform_api": "^1.0.0",
    "plugin_api": "^1.0.0"
  },
  "dependencies": [],
  "execution": {
    "mode": "process",
    "executable": "backend/dufs",
    "args": [],
    "environment": [],
    "bind": { "host": "127.0.0.1", "port": 18103 }
  },
  "backend": {
    "api_version": "v1",
    "base_path": "/api/modules/dufs",
    "service": "dufs.api",
    "routes": [
      { "id": "root", "path": "/", "upstream_path": "/", "methods": ["GET", "HEAD"], "auth": "module", "permission": null },
      { "id": "browse", "path": "/{*path}", "upstream_path": "/{*path}", "methods": ["GET", "HEAD"], "auth": "module", "permission": null },
      { "id": "upload", "path": "/{*path}", "upstream_path": "/{*path}", "methods": ["POST", "PUT"], "auth": "module", "permission": null },
      { "id": "delete", "path": "/{*path}", "upstream_path": "/{*path}", "methods": ["DELETE"], "auth": "module", "permission": null }
    ]
  },
  "frontend": {
    "entry": "frontend/entry.js",
    "styles": ["frontend/styles.css"],
    "components": ["DufsView"],
    "api_base": "/api/modules/dufs",
    "routes": [
      { "path": "/modules/dufs", "component": "DufsView", "permission": "dufs.files.read" }
    ],
    "menu": [
      { "id": "files", "label": "文件", "route": "/modules/dufs", "permission": "dufs.files.read", "order": 30 }
    ]
  },
  "permissions": [
    { "id": "dufs.files.read", "description": "浏览和下载共享文件", "default_roles": ["admin"] },
    { "id": "dufs.files.write", "description": "上传和修改共享文件", "default_roles": ["admin"] },
    { "id": "dufs.files.delete", "description": "删除共享文件", "default_roles": ["admin"] }
  ],
  "migrations": [
    { "id": "state-v1", "engine": "embedded" }
  ],
  "configuration": {
    "schema": "config/schema.json",
    "version": 1,
    "secret_fields": ["/auth"]
  },
  "health": {
    "kind": "http",
    "service": "dufs.api",
    "liveness_path": "/__dufs__/health",
    "readiness_path": "/__dufs__/ready",
    "interval_seconds": 10,
    "timeout_seconds": 2
  },
  "lifecycle": {
    "startup_timeout_seconds": 30,
    "shutdown_timeout_seconds": 30,
    "restart_policy": "on_failure",
    "max_restarts": 5
  },
  "services": [
    { "name": "dufs.api", "protocol": "http", "visibility": "platform" }
  ],
  "events": {
    "publishes": [{ "topic": "dufs.file.changed", "version": 1 }],
    "subscribes": []
  }
}
