{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sarmg.org/foundation/consumer-matrix.v1.schema.json",
  "title": "Sarmg Foundation consumer verification matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "format",
    "foundation_version",
    "updated_on",
    "consumers"
  ],
  "properties": {
    "$schema": {
      "const": "./consumer-matrix.schema.json"
    },
    "format": {
      "const": "sarmg.consumer-matrix.v1"
    },
    "foundation_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "updated_on": {
      "type": "string",
      "format": "date"
    },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/consumer"
      }
    }
  },
  "$defs": {
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "adopted_version",
        "packages",
        "status",
        "last_verified_commit"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        },
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "adopted_version": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "packages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "@sarmg/admin-web",
              "@sarmg/contracts",
              "@sarmg/design-tokens",
              "@sarmg/http-client",
              "sarmg-admin-auth",
              "sarmg-contracts",
              "sarmg-error",
              "sarmg-schema-identity",
              "sarmg-server-target",
              "sarmg-sqlite"
            ]
          }
        },
        "status": {
          "enum": [
            "not-integrated",
            "integration-pending",
            "passing",
            "failing"
          ]
        },
        "last_verified_commit": {
          "anyOf": [
            {
              "$ref": "#/$defs/commit"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  }
}
