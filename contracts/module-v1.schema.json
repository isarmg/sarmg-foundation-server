{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sarmg.org/contracts/module-v1.schema.json",
  "title": "Sarmg private-process module descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "display_name",
    "description",
    "version",
    "execution",
    "ui",
    "capabilities",
    "service",
    "database"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "description": { "type": "string", "minLength": 1, "maxLength": 512 },
    "version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "execution": { "const": "private_process" },
    "ui": { "$ref": "#/$defs/ui" },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
        "maxLength": 128
      },
      "uniqueItems": true
    },
    "service": { "$ref": "#/$defs/service" },
    "database": {
      "oneOf": [
        { "$ref": "#/$defs/postgresSchema" },
        { "$ref": "#/$defs/dedicatedPostgres" },
        { "$ref": "#/$defs/embeddedSqlite" }
      ]
    }
  },
  "$defs": {
    "absolutePath": {
      "type": "string",
      "pattern": "^/(?!/)[^?#]*$",
      "maxLength": 512
    },
    "databaseEnvironment": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
    },
    "postgresIdentifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,62}$"
    },
    "ui": {
      "oneOf": [
        { "$ref": "#/$defs/consoleUi" },
        { "$ref": "#/$defs/gatewayUi" }
      ]
    },
    "consoleUi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "route"],
      "properties": {
        "kind": { "const": "console" },
        "route": { "$ref": "#/$defs/absolutePath" }
      }
    },
    "gatewayUi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "entry_path"],
      "properties": {
        "kind": { "const": "gateway" },
        "entry_path": { "$ref": "#/$defs/absolutePath" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binary",
        "bind",
        "gateway_prefix",
        "liveness_path",
        "readiness_path"
      ],
      "properties": {
        "binary": {
          "type": "string",
          "pattern": "^[a-z](?:[a-z0-9-]{0,62}[a-z0-9])?$"
        },
        "bind": {
          "type": "string",
          "pattern": "^(?:127\\.0\\.0\\.1|\\[::1\\]):[1-9][0-9]{0,4}$"
        },
        "gateway_prefix": {
          "type": "string",
          "pattern": "^/modules/[a-z](?:[a-z0-9-]{0,62}[a-z0-9])?$"
        },
        "liveness_path": { "$ref": "#/$defs/absolutePath" },
        "readiness_path": { "$ref": "#/$defs/absolutePath" }
      }
    },
    "postgresSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "database_env", "schema", "role"],
      "properties": {
        "profile": { "const": "postgres_schema" },
        "database_env": { "$ref": "#/$defs/databaseEnvironment" },
        "schema": { "$ref": "#/$defs/postgresIdentifier" },
        "role": { "$ref": "#/$defs/postgresIdentifier" }
      }
    },
    "dedicatedPostgres": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "database_env", "role"],
      "properties": {
        "profile": { "const": "dedicated_postgres" },
        "database_env": { "$ref": "#/$defs/databaseEnvironment" },
        "role": { "$ref": "#/$defs/postgresIdentifier" }
      }
    },
    "embeddedSqlite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "state_directory", "rationale"],
      "properties": {
        "profile": { "const": "embedded_sqlite" },
        "state_directory": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_./-]*$",
          "maxLength": 255
        },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    }
  }
}
