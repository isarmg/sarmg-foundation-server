{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sarmg.org/contracts/module-v1.schema.json",
  "title": "Sarmg platform module descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "display_name", "description", "version",
    "execution", "ui", "capabilities", "service", "database"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z](?:[a-z0-9-]{0,62}[a-z0-9])?$" },
    "display_name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "execution": { "enum": ["in_process", "service"] },
    "ui": { "type": "object" },
    "capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "service": { "type": ["object", "null"] },
    "database": { "type": "object" }
  }
}
